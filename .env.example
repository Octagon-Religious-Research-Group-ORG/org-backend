PORT=50000
# A replica set, even a single node: claim decisions use transactions and
# answer 503 on a standalone server. Locally: mongod --replSet rs0, then
# rs.initiate() once in mongosh. Atlas is always a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/org?replicaSet=rs0
# Optional: bypass a router, VPN, or ISP DNS proxy that rejects Atlas SRV lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Comma-separated verified member emails that receive full website admin access.
WHITE_LISTED_EMAILS=
CLIENT_ORIGIN_URL=http://localhost:50073
PUBLIC_APP_URL=http://localhost:50073
# Reverse-proxy hops in front of the API (Render/Heroku: 1; direct, no proxy: 0).
TRUST_PROXY_HOPS=1
# Members-area indexes at startup: check (report only, default) or create (create missing, never drop).
MANAGE_INDEXES=check
# production (default) or test. On test the real PayPal/Venmo accounts are never shown and every email is marked [TEST SITE].
SITE_ENV=production
PAYPAL_DONATION_URL=https://paypal.me/trippaardema
VENMO_DONATION_URL=https://venmo.com/u/the_org
RESEND_API_KEY=
ORDER_FROM_EMAIL=offerings@example.org
ORDER_NOTIFICATION_EMAIL=host@example.org
# Member notifications (optional). The sender falls back to ORDER_FROM_EMAIL.
NOTIFICATION_FROM_EMAIL=
# Signs unsubscribe links (32+ characters); derived from CLERK_SECRET_KEY when empty.
NOTIFICATION_SIGNING_SECRET=
# This backend's public address, for one-click unsubscribe headers, e.g.
# https://org-backend.example.org (a trailing slash or /api/v1 is accepted and
# removed). A bad value is logged at start-up and ignored.
PUBLIC_API_URL=
# Each site's share of the shared Resend free tier (100 a day for both sites).
# Defaults: production 70 / 20, test 20 / 5.
EMAIL_DAILY_LIMIT=
EMAIL_IMMEDIATE_RESERVE=
# UTC hour from which the daily digest goes out (default 14).
DIGEST_HOUR_UTC=
